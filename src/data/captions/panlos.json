[
  { "start": 0,    "end": 2.5,  "text": "Selamat datang di Pantai Losari." },
  { "start": 2.5,  "end": 4.8,  "text": "Di titik ini, suasana pesisir" },
  { "start": 4.8,  "end": 6.9,  "text": "Kota Makassar mulai terasa." },
  { "start": 6.9,  "end": 9.0,  "text": "Angin laut berhembus pelan," },
  { "start": 9.0,  "end": 11.9, "text": "sementara ruang terbuka di depan Anda" },
  { "start": 11.9, "end": 14.3, "text": "memperlihatkan wajah waterfront" },
  { "start": 14.3, "end": 16.6, "text": "yang menjadi kebanggaan kota." },
  { "start": 16.6, "end": 20.1, "text": "Dari sinilah perjalanan virtual kita dimulai," },
  { "start": 20.1, "end": 23.2, "text": "menyusuri kawasan yang hidup oleh laut," },
  { "start": 23.2, "end": 26.0, "text": "budaya, dan aktivitas masyarakatnya." }
]
